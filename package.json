    "test:observer": "node scripts/test-observer.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/monaspace-xenon": "^5.3.0",
    "@noble/curves": "^2.0.1",
