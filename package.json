{
  "name": "rholox",
  "private": true,
  "version": "0.9.1",
  "type": "module",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js --host 0.0.0.0",
    "build": "node node_modules/typescript/bin/tsc -b && node node_modules/vite/bin/vite.js build && node scripts/write-notices.mjs && node scripts/package-rev-endpoint.mjs && npm run check:public-package",
    "preview": "node node_modules/vite/bin/vite.js preview --host 0.0.0.0",
    "verify:source": "node scripts/verify-source.mjs",
    "verify": "npm run verify:source && npm run test:amm && npm run test:amm:actors && npm run test:exchange:recovery-source && npm run test:observer && npm run test:network-evidence && npm run test:state-integrity && npm run build && npm run test:rev-snapshot && npm run test:rev-endpoint",
    "test:amm": "node scripts/test-amm.mjs",
    "test:amm:actors": "node scripts/test-amm-actors.mjs",
    "test:exchange:recovery-source": "node scripts/test-exchange-recovery-source.mjs",
    "test:exchange:rholang": "node scripts/test-exchange-recovery-rholang.mjs",
    "test:observer": "node scripts/test-observer.mjs",
    "test:rev-snapshot": "node scripts/test-rev-snapshot.mjs",
    "test:rev-endpoint": "php scripts/test-rev-endpoint.php",
    "prepare:rev-snapshot": "node scripts/prepare-rev-snapshot.mjs",
    "check:public-package": "node scripts/check-public-package.mjs",
    "test:network-evidence": "node scripts/test-network-evidence.mjs",
    "test:state-integrity": "node scripts/test-state-integrity.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@noble/curves": "^2.0.1",
    "blakejs": "^1.2.1",
    "bs58": "^6.0.0",
    "js-sha3": "^0.9.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.4.5"
  }
}
